# Expected Stellar network ('Testnet' or 'Mainnet'; also accepts 'public', 'pubnet', 'livenet')
VITE_STELLAR_NETWORK=Testnet

# Set to a non-empty value (e.g. true) to load local fixture data on the Subscriptions page instead of calling /api/subscriptions
VITE_USE_FIXTURES=

# External support link URL
VITE_SUPPORT_URL=https://github.com/Stellabill/stellabill-frontend/issues

# External Stellar wallets documentation URL
VITE_STELLAR_WALLETS_DOCS_URL=https://docs.stellar.org/wallets

# External Stellabill documentation URL
VITE_DOCS_URL=https://github.com/Stellabill/stellabill-frontend/tree/main/docs
